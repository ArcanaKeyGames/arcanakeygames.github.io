---
// Base layout: document head (meta, OG tags, fonts), nav, footer.
// Pages supply their content between nav and footer.
import { site } from "../config/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.gameName} — ${site.studioName}`,
  description = site.description,
} = Astro.props;

const ogImage = new URL(site.ogImage, Astro.site);

// Footer links render only when configured (nothing points nowhere).
const footerLinks = [
  { label: "YouTube", href: site.links.youtube },
  { label: "Ko-fi", href: site.links.kofi },
  { label: "itch.io", href: site.links.itch },
  {
    label: "Contact",
    href: site.links.contactEmail ? `mailto:${site.links.contactEmail}` : null,
  },
].filter((l) => l.href !== null);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta
      name="theme-color"
      content="#faf6f0"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#14110b"
      media="(prefers-color-scheme: dark)"
    />

    {/* Runs before first paint: a dark-mode visitor never sees a white
        flash. Only an explicit choice is stored — with none, the CSS
        follows the OS on its own. */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          if (saved === "dark" || saved === "light") {
            document.documentElement.setAttribute("data-theme", saved);
          }
        } catch (e) {}
      })();
    </script>
    <link rel="canonical" href={Astro.url} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.studioName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,400;0,700;0,900;1,400&family=Merriweather+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="site-nav">
      <div class="wrap nav-inner">
        <a class="wordmark sans" href="/">{site.studioName.toUpperCase()}</a>
        <nav class="sans" aria-label="Site">
          {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
          <a class="btn btn-ghost nav-cta" href="#signup" aria-label="Get Updates">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="5.5" width="18" height="13" rx="2" />
              <path d="M3.5 7l8.5 6.2L20.5 7" />
            </svg>
            <span class="nav-label">Get Updates</span>
          </a>
          {
            site.links.youtube && (
              <a
                class="btn btn-ghost nav-cta"
                href={site.links.youtube}
                rel="noopener"
                aria-label="Watch Videos"
                title={`${site.studioName} on YouTube`}
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="2.5" y="5" width="19" height="14" rx="4" />
                  <path d="M10 9.1v5.8l5-2.9z" fill="currentColor" stroke="none" />
                </svg>
                <span class="nav-label">Watch Videos</span>
              </a>
            )
          }
          {
            site.links.kofi && (
              <a
                class="btn btn-ghost nav-cta"
                href={site.links.kofi}
                rel="noopener"
                aria-label="Support Us"
                title={`Support ${site.studioName} on Ko-fi`}
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M4 7.5h11.5v6.5a4.5 4.5 0 0 1-4.5 4.5H8.5A4.5 4.5 0 0 1 4 14z" />
                  <path d="M15.5 9.5h1.8a2.6 2.6 0 0 1 0 5.2h-1.8" />
                  <path d="M9.75 14.4c-1.4-.9-2.2-1.8-2.2-2.7 0-.7.5-1.2 1.2-1.2.4 0 .8.2 1 .6.2-.4.6-.6 1-.6.7 0 1.2.5 1.2 1.2 0 .9-.8 1.8-2.2 2.7z" fill="currentColor" stroke="none" />
                </svg>
                <span class="nav-label">Support Us</span>
              </a>
            )
          }
          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-label="Switch to dark theme"
            title="Switch theme"
          >
            <svg
              class="icon-sun"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4.2" />
              <path
                d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6"
              />
            </svg>
            <svg
              class="icon-moon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2z" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;

        function current() {
          var set = root.getAttribute("data-theme");
          if (set) return set;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        function syncLabel() {
          var next = current() === "dark" ? "light" : "dark";
          btn.setAttribute("aria-label", "Switch to " + next + " theme");
        }

        syncLabel();

        btn.addEventListener("click", function () {
          var next = current() === "dark" ? "light" : "dark";
          root.setAttribute("data-theme", next);
          try {
            localStorage.setItem("theme", next);
          } catch (e) {}
          syncLabel();
        });

        // If the visitor never chose explicitly, keep following the OS
        // when it changes (e.g. a scheduled night shift).
        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", function () {
            if (!root.getAttribute("data-theme")) syncLabel();
          });
      })();
    </script>

    <footer class="site-footer sans">
      <div class="wrap footer-inner">
        <a class="footer-logo" href="/" aria-label={`${site.studioName} home`}>
          <img
            src="/media/akg-logo-full.webp"
            alt={site.studioName}
            width="380"
            height="154"
            loading="lazy"
          />
        </a>
        <div class="footer-right">
          <div class="footer-links">
            {
              footerLinks.map((l) => (
                <a href={l.href!} rel="noopener">
                  {l.label}
                </a>
              ))
            }
          </div>
          <p class="footer-credit">&copy; {new Date().getFullYear()} {site.studioName}</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Anchored to the top so the theme toggle and the wordmark (which is
     also the jump-to-top link) stay reachable from anywhere on the page.
     The background is opaque and the gold rule sits on the bottom edge,
     so content passes cleanly underneath rather than showing through. */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 2px solid var(--gold);
    background: var(--nav-bg);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
  }

  /* Both of these are kept to one line. Wrapped, they made the bar 91px
     on a phone — a third of that height again, and permanent now that it
     is anchored. The button was the worse offender, breaking across two
     lines on its own. */
  .wordmark {
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.22em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    white-space: nowrap;
  }

  .nav-cta svg {
    width: 17px;
    height: 17px;
    flex: none;
  }

  .wordmark:hover {
    color: var(--gold-accent);
  }

  .site-nav nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .site-nav nav a {
    text-decoration: none;
    color: var(--ink-soft);
  }

  .site-nav nav a:hover {
    color: var(--gold-accent);
  }

  .nav-cta {
    padding: 0.42rem 1rem;
    font-size: 0.85rem;
  }

  /* Three labelled buttons no longer fit beside the wordmark on a tablet,
     so below 900px they shed their labels and become round icon buttons
     matching the theme toggle; each keeps an aria-label and a title, so
     nothing is lost to screen readers or hover. */
  @media (max-width: 900px) {
    .nav-cta {
      width: 34px;
      height: 34px;
      padding: 0;
      justify-content: center;
      border-radius: 999px;
    }
    .nav-cta .nav-label {
      display: none;
    }
  }

  /* On a phone the four round buttons stay, so every link in the bar is
     reachable from anywhere on the page; the whole row just gets a size
     smaller — tighter gaps, 30px buttons, and a wordmark with a little
     less tracking — which still fits a 360px screen on one line. */
  @media (max-width: 540px) {
    .site-nav nav {
      gap: 0.5rem;
    }
    .wordmark {
      font-size: 0.8rem;
      letter-spacing: 0.15em;
    }
    /* .site-nav prefix: the toggle's base rule comes later in the file
       and would otherwise win the width. */
    .site-nav .nav-cta,
    .site-nav .theme-toggle {
      width: 30px;
      height: 30px;
    }
    .site-nav .nav-cta svg,
    .site-nav .theme-toggle svg {
      width: 15px;
      height: 15px;
    }
  }


  /* The button shows the theme you'd switch TO, which is the convention
     users read fastest: a moon while it's light out. */
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1.5px solid color-mix(in srgb, var(--gold) 60%, transparent);
    border-radius: 999px;
    background: transparent;
    color: var(--gold-accent);
    cursor: pointer;
    transition: background-color 140ms ease, border-color 140ms ease,
      color 140ms ease;
  }

  .theme-toggle:hover {
    background: color-mix(in srgb, var(--gold) 14%, transparent);
    border-color: var(--gold);
    color: var(--ink);
  }

  .theme-toggle svg {
    width: 17px;
    height: 17px;
  }

  .theme-toggle .icon-sun {
    display: none;
  }

  :root[data-theme="dark"] .theme-toggle .icon-sun {
    display: block;
  }

  :root[data-theme="dark"] .theme-toggle .icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .theme-toggle .icon-sun {
      display: block;
    }
    :root:not([data-theme]) .theme-toggle .icon-moon {
      display: none;
    }
  }

  .site-footer {
    border-top: 1px solid color-mix(in srgb, var(--gold) 55%, transparent);
    padding-block: 2rem 2.25rem;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-logo {
    display: block;
    line-height: 0;
  }

  .footer-logo img {
    width: clamp(200px, 26vw, 300px);
    height: auto;
  }

  .footer-right {
    text-align: right;
  }

  .footer-links {
    display: flex;
    gap: 1.25rem;
    font-size: 0.85rem;
    justify-content: flex-end;
  }

  .footer-credit {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--mud);
  }

  @media (max-width: 560px) {
    .footer-inner {
      justify-content: center;
      text-align: center;
      flex-direction: column;
    }
    .footer-right {
      text-align: center;
    }
    .footer-links {
      justify-content: center;
    }
  }
</style>
